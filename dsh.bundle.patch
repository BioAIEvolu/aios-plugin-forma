# name. DSH itself consumes the cordis.patch.yml path declared in package.json.
- insert:
    - id: forma
      name: aios-plugin-forma
      config:
        runtimeDigest: "sha256:2cbe711404e38eef5a9a713096ec93429fcb697ddbeb537e210b4b6605afaeb0"
        workRoot: !!js process.env.FORMA_WORK_ROOT
        sourceRootsJson: !!js process.env.FORMA_SOURCE_ROOTS_JSON
        reviewedSourceRootsJson: !!js process.env.FORMA_REVIEWED_SOURCE_ROOTS_JSON
        timeoutMs: 15000
